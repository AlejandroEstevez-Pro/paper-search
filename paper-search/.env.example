# Plantilla de configuración local de paper-search.
#
# Copia este archivo a `.env` (en esta misma carpeta) y rellena los valores:
#
#   PowerShell:  Copy-Item .env.example .env
#   bash/zsh:    cp .env.example .env
#
# `.env` está en .gitignore y NUNCA debe subirse al repositorio: contiene
# claves reales. Este `.env.example` sí se versiona, siempre con valores
# vacíos.
#
# Lo que esté exportado en el entorno del sistema tiene prioridad sobre lo que
# haya aquí.

# Necesaria para generar el resumen en lenguaje llano. Se consigue en
# https://console.anthropic.com/ — empieza por "sk-ant-".
ANTHROPIC_API_KEY=

# Opcionales (ver el README). Descomenta solo las que vayas a usar.
# Sube el límite de PubMed de 3 a 10 peticiones/segundo:
#NCBI_API_KEY=
# Email de contacto que pide NCBI; si no se define se usa el del autor:
#NCBI_EMAIL=

# Base de datos local (caché, límites de uso, registro). Todas opcionales.
# Ruta del archivo SQLite (por defecto paper-search/datos/paper-search.db):
#PAPER_SEARCH_DB=
# Días de vigencia de la caché de resúmenes (por defecto 30):
#PAPER_SEARCH_CACHE_DIAS=
# Límites diarios de uso (por defecto 50 búsquedas y 200 llamadas a Claude):
#PAPER_SEARCH_MAX_BUSQUEDAS_DIA=
#PAPER_SEARCH_MAX_LLAMADAS_DIA=
